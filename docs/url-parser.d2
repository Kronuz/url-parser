# url-parser: a request path split into its parts, and query keys read on demand.
# Render: d2 --layout elk --sketch --theme 302 docs/url-parser.d2 docs/url-parser.svg
vars: { d2-config: { layout-engine: elk; theme-id: 302; sketch: true; pad: 24 } }
grid-rows: 2
grid-columns: 2
horizontal-gap: 180
vertical-gap: 100

path: path {
  width: 300
  height: 160
  label: "request path\ntwitter@node1/1234:count"
}
parts: PathParser {
  width: 300
  height: 160
  label: "PathParser\nhost: node1 · path: twitter\nid: 1234 · command: :count"
}
query: query {
  width: 300
  height: 160
  label: "query string\nfoo=1&bar=hello%20world&flag"
}
qp: QueryParser {
  width: 300
  height: 160
  label: "QueryParser\nnext(\"bar\") → \"hello world\"\nnext(\"flag\") → \"\""
}

path -> parts: "init() · next()"
query -> qp: "next(key)"
